<Project Sdk="Microsoft.NET.Sdk">
    <!-- Tests that start the app on Avalonia's headless platform: no window opens, so they run anywhere, CI included.
         dotnet test from the solution folder runs them. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../HoverTrans/HoverTrans.csproj" />
    </ItemGroup>
</Project>
