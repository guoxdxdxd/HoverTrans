<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- net11.0 is the macOS/Linux build; the Windows build adds UI Automation and Windows.Media.Ocr. -->
        <TargetFrameworks>net11.0-windows10.0.19041.0</TargetFrameworks>
        <!-- The update check compares this with the latest GitHub release tag, so it must be a plain version.
             packaging/build-installer.ps1 passes the release version in (-p:Version) when it packages a build. -->
        <Version>0.1.0</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- FlaUI's UIA3 automation activates the UI Automation COM objects, so the Windows build must keep built-in COM:
             with it off, "new UIA3Automation()" throws NotSupportedException while the app is starting and the process dies
             before the window appears. The other targets have no COM and stay lean. -->
        <BuiltInComInteropSupport Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">true</BuiltInComInteropSupport>
        <BuiltInComInteropSupport Condition="'$(TargetFramework)' != 'net11.0-windows10.0.19041.0'">false</BuiltInComInteropSupport>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">10.0.17763.0</SupportedOSPlatformVersion>
        <!-- The .NET 11 SDK's optimized AOT publish drops Avalonia's compiled XAML ("No precompiled XAML found" at start). -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
    </PropertyGroup>

    <ItemGroup>
        <!-- Arc is built against this exact Avalonia version; keep every Avalonia package on it. -->
        <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
        <!-- Local inference, in-process: no llama.cpp, no child process, no local HTTP server.
             Sdcb.GgufWeights.Hy-MT3-1.8B-Q4_K_M is the model itself (six assemblies, ~1.35 GB) and
             Part2..Part6 come with it as dependencies, so it is restored and published, not committed.
             Both are Apache-2.0; see packaging/THIRD-PARTY-NOTICES.txt. -->
        <PackageReference Include="Sdcb.GgufWeights.Hy-MT3-1.8B-Q4_K_M" Version="1.0.0" />
        <PackageReference Include="Sdcb.HyMT2Sharp" Version="2.0.0" />
        <PackageReference Include="TKCode.Arc" Version="1.3.1" />
        <!-- View models: [ObservableProperty] and [RelayCommand] are source-generated, so there is no reflection. -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
        <PackageReference Include="TKCode.Arc.Blocks" Version="1.3.1" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="1.3.1" />
        <!-- Only the Lucide icons the app uses are compiled in. Icons chosen at run time (bindings, data) are declared:
             <LucideIcon Include="Bell;ArrowRight" />, or set <LucideIconsIncludeAll>true</LucideIconsIncludeAll>. -->
        <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.3.1" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
        <!-- UI Automation wrapper used by the hover text source. Windows-only. -->
        <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    </ItemGroup>
</Project>
