<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
        xmlns:vm="using:HoverTrans.ViewModels"
        x:Class="HoverTrans.Views.HoverWindow"
        x:DataType="vm:HoverViewModel"
        Width="440"
        Height="240"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <!-- The popup is the app's smallest surface: source, translation, one status line. It rises in when it appears
         (Views/HoverWindow.axaml.cs) and never takes focus from what the person is reading. -->
    <Border x:Name="Root"
            Margin="10"
            Padding="16,14"
            CornerRadius="16"
            Background="{arc:ArcDesignTokenResource Surface}"
            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
            BorderThickness="1"
            BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Border Width="18"
                            Height="18"
                            CornerRadius="6"
                            Background="{arc:ArcDesignTokenResource Accent}">
                        <lucide:LucideIcon Kind="Languages"
                                           Size="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource AccentForeground}" />
                    </Border>
                    <TextBlock Text="悬译"
                               FontWeight="SemiBold"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <TextBlock Text="悬停翻译"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ProgressBar Width="48"
                                 Height="2"
                                 Margin="0,0,6,0"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsTranslating}"
                                 VerticalAlignment="Center" />
                    <arc:CopyButton Value="{Binding TranslationText}"
                                    IsIconOnly="True"
                                    Variant="Plain"
                                    Width="26"
                                    Height="26"
                                    MinHeight="0"
                                    Label="复制译文"
                                    CopiedLabel="已复制"
                                    FailedLabel="复制失败"
                                    AutomationProperties.Name="复制译文"
                                    IsVisible="{Binding HasTranslation}"
                                    arc:Tooltip.Tip="复制译文"
                                    arc:Tooltip.Side="Bottom" />
                    <arc:Button Width="26"
                                Height="26"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="8"
                                Variant="Ghost"
                                AutomationProperties.Name="打开主窗口"
                                arc:Tooltip.Tip="打开悬译主窗口"
                                arc:Tooltip.Side="Bottom"
                                Click="OnOpenMainClick">
                        <lucide:LucideIcon Kind="ExternalLink" Size="13" />
                    </arc:Button>
                    <arc:Button Width="26"
                                Height="26"
                                MinHeight="0"
                                Padding="0"
                                CornerRadius="8"
                                Variant="Ghost"
                                AutomationProperties.Name="关闭"
                                arc:Tooltip.Tip="关闭"
                                arc:Tooltip.Side="Bottom"
                                Click="OnCloseClick">
                        <lucide:LucideIcon Kind="X" Size="13" />
                    </arc:Button>
                </StackPanel>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,10,0,0">
                <TextBlock Text="{Binding Status}"
                           IsVisible="{Binding !IsError}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}"
                           IsVisible="{Binding IsError}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource Danger}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Text="{Binding SourceText}"
                           MaxLines="3"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           LineHeight="20"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

                <Border Grid.Row="1"
                        Height="1"
                        Margin="0,10"
                        Background="{arc:ArcDesignTokenResource BorderSubtle}" />

                <Grid Grid.Row="2">
                    <!-- Selectable text: the translation can be selected and copied like any text, with Ctrl+C or the
                         right-click menu, including a part of it. Not a TextBox: Arc themes no TextBox, so one would
                         render nothing here. -->
                    <SelectableTextBlock Text="{Binding TranslationText}"
                                         IsVisible="{Binding HasTranslation}"
                                         TextWrapping="Wrap"
                                         FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                         LineHeight="27"
                                         Foreground="{arc:ArcDesignTokenResource Foreground}"
                                         SelectionBrush="{arc:ArcDesignTokenResource AccentSubtle}" />

                    <arc:Skeleton Lines="2" IsVisible="{Binding IsWaiting}" Margin="0,2,0,0" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
