<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:HoverTrans.ViewModels"
             x:Class="HoverTrans.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{arc:ArcDesignTokenResource Background}">
    <UserControl.Styles>
        <!-- On the icon rail the brand and the footer keep only their leading part; the rest fades out. -->
        <Style Selector="arc|Sidebar :is(Control).rail-fade">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="arc|Sidebar:collapsed :is(Control).rail-fade">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="arc|Sidebar:motion-full :is(Control).rail-fade">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="arc|Button.panel-toggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeLG}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
    </UserControl.Styles>

    <DockPanel ClipToBounds="True">
        <!-- Navigation: three pages, a count on the history row, and a footer that says what the app does with data.
             The page glides with the sidebar's edge (PageShift) while the sidebar folds to its 64px rail. -->
        <arc:Sidebar x:Name="Nav"
                     DockPanel.Dock="Left"
                     IsCollapseButtonVisible="False"
                     ResizeMode="Overlay"
                     ExpandedWidth="236"
                     Label="主导航"
                     SelectedKey="{Binding SelectedKey}">
            <arc:Sidebar.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="9"
                            Background="{arc:ArcDesignTokenResource Accent}">
                        <lucide:LucideIcon Kind="Languages"
                                           Size="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource AccentForeground}" />
                    </Border>
                    <StackPanel Classes="rail-fade" VerticalAlignment="Center">
                        <TextBlock Text="悬译"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Text="HoverTrans"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </StackPanel>
                </StackPanel>
            </arc:Sidebar.Header>

            <arc:SidebarSection>
                <arc:SidebarItem Key="translate" Label="翻译" Icon="{lucide:LucideGeometry Languages}" />
                <arc:SidebarItem Key="history" Label="历史" Icon="{lucide:LucideGeometry History}" Badge="{Binding HistoryBadge}" />
            </arc:SidebarSection>
            <arc:SidebarSection>
                <arc:SidebarItem Key="settings" Label="设置" Icon="{lucide:LucideGeometry Settings}" />
            </arc:SidebarSection>

            <arc:Sidebar.Footer>
                <StackPanel Classes="rail-fade" Spacing="1" Margin="6,0,0,0">
                    <TextBlock Text="全程本地运行"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    <TextBlock Text="不上传云端 · MIT 开源"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </arc:Sidebar.Footer>
        </arc:Sidebar>

        <Grid RowDefinitions="Auto,*" RenderTransform="{Binding #Nav.PageShift}">
            <!-- The top bar carries what applies to every page: the model state, the hover switch and light/dark. -->
            <Border Height="64"
                    Padding="16,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <arc:Button Classes="panel-toggle"
                                Variant="Ghost"
                                AutomationProperties.Name="收起侧栏"
                                arc:Tooltip.Tip="收起或展开侧栏"
                                arc:Tooltip.Side="Bottom"
                                Click="OnToggleSidebar">
                        <lucide:LucideIcon Kind="PanelLeft" Size="16" />
                    </arc:Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Classes="page-title" Text="{Binding Title}" />
                        <TextBlock Classes="page-subtitle" Text="{Binding Subtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Padding="10,5"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                VerticalAlignment="Center"
                                arc:Tooltip.Tip="{Binding State.ModelStatus}"
                                arc:Tooltip.Side="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="7"
                                        Height="7"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{arc:ArcDesignTokenResource Success}"
                                        IsVisible="{Binding State.IsModelRunning}" />
                                <Border Width="7"
                                        Height="7"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{arc:ArcDesignTokenResource TextMuted}"
                                        IsVisible="{Binding State.IsModelStopped}" />
                                <TextBlock Text="{Binding State.ModelBadgeText}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <arc:Switch Content="悬停取词"
                                    IsChecked="{Binding State.HoverEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding State.IsHoverSupported}"
                                    arc:Tooltip.Tip="{Binding State.HoverHint}"
                                    arc:Tooltip.Side="Bottom" />

                        <arc:ThemeSwitcher IsIconOnly="True" Variant="Reveal" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pages keep their state while you move between them; the switch crossfades instead of snapping. -->
            <TransitioningContentControl Grid.Row="1"
                                         Content="{Binding CurrentPageView}"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.18" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>
    </DockPanel>
</UserControl>
