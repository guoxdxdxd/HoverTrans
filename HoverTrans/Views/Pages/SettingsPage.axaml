<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:HoverTrans.ViewModels"
             x:Class="HoverTrans.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
    <DockPanel Margin="24,18,24,20">
        <!-- The backend is saved with a button because it is read when the app starts. -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                Padding="16,12"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveStatus}"
                               IsVisible="{Binding !IsSaveError}"
                               TextWrapping="Wrap"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    <TextBlock Text="{Binding SaveStatus}"
                               IsVisible="{Binding IsSaveError}"
                               TextWrapping="Wrap"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               Foreground="{arc:ArcDesignTokenResource Danger}" />
                </StackPanel>
                <arc:Button Grid.Column="1"
                            Content="保存设置"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.Name="保存设置" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.BringIntoViewOnFocusChange="False">
            <StackPanel Spacing="16"
                        MaxWidth="{arc:ArcDesignTokenResource ContentMaxWidthMD}"
                        HorizontalAlignment="Left">

                <arc:SettingsGroup Header="本地模型"
                                   Description="Hy-MT3 1.8B（Q4_K_M）随应用分发，在本进程内推理；后端改动在下次启动时生效。">
                    <arc:SettingsRow Header="推理后端" Description="自动：显卡能用就走显卡，否则用 CPU。显卡后端不可用时会自动回退到 CPU。">
                        <arc:SegmentedControl SelectedValue="{Binding Backend, Mode=TwoWay}"
                                              AutomationProperties.Name="推理后端">
                            <arc:SegmentedOption Value="auto" Label="自动" />
                            <arc:SegmentedOption Value="cpu" Label="仅 CPU" />
                            <arc:SegmentedOption Value="vulkan" Label="显卡" />
                        </arc:SegmentedControl>
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="模型状态" Description="{Binding State.ModelStatus}">
                        <TextBlock Text="{Binding ModelInfo}"
                                   MaxWidth="420"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </arc:SettingsRow>
                </arc:SettingsGroup>

                <arc:SettingsGroup Header="悬停取词" Description="{Binding State.HoverHint}">
                    <arc:SettingsRow Header="启用悬停取词" Description="鼠标停在文字上约半秒，就在旁边弹出译文。">
                        <arc:Switch IsChecked="{Binding State.HoverEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding State.IsHoverSupported}"
                                    AutomationProperties.Name="启用悬停取词" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="触发延迟" Description="停留多久开始翻译；太短容易误触，太长显得迟钝。">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <arc:Slider Width="220"
                                        Minimum="200"
                                        Maximum="1500"
                                        SmallChange="50"
                                        Value="{Binding HoverDelay, Mode=TwoWay}"
                                        IsValueVisible="False"
                                        AutomationProperties.Name="悬停触发延迟" />
                            <TextBlock Text="{Binding HoverDelay, StringFormat='{}{0:0} 毫秒'}"
                                       VerticalAlignment="Center"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </arc:SettingsRow>
                </arc:SettingsGroup>

                <arc:SettingsGroup Header="外观" Description="主题和强调色立即生效，并会记住。">
                    <arc:SettingsRow Header="主题" Description="跟随系统时，Windows 切换深色模式也会跟着变。">
                        <arc:SegmentedControl SelectedValue="{Binding Appearance, Mode=TwoWay}"
                                              AutomationProperties.Name="主题">
                            <arc:SegmentedOption Value="System" Label="跟随系统" />
                            <arc:SegmentedOption Value="Light" Label="浅色" />
                            <arc:SegmentedOption Value="Dark" Label="深色" />
                        </arc:SegmentedControl>
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="强调色" Description="按钮、选中态和焦点环用的颜色。">
                        <arc:Select Width="180"
                                    SelectedValue="{Binding Accent, Mode=TwoWay}"
                                    AutomationProperties.Name="强调色">
                            <arc:SelectItem Content="中性" Value="Neutral" />
                            <arc:SelectItem Content="紫罗兰" Value="Violet" />
                            <arc:SelectItem Content="蓝" Value="Blue" />
                            <arc:SelectItem Content="绿" Value="Green" />
                            <arc:SelectItem Content="琥珀" Value="Amber" />
                            <arc:SelectItem Content="橙" Value="Orange" />
                            <arc:SelectItem Content="珊瑚" Value="Coral" />
                            <arc:SelectItem Content="玫红" Value="Rose" />
                        </arc:Select>
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="动效" Description="界面的弹簧和过渡强度；减弱只保留短淡入。">
                        <arc:SegmentedControl SelectedValue="{Binding MotionLevel, Mode=TwoWay}"
                                              AutomationProperties.Name="动效">
                            <arc:SegmentedOption Value="Full" Label="完整" />
                            <arc:SegmentedOption Value="Reduced" Label="减弱" />
                            <arc:SegmentedOption Value="Off" Label="关闭" />
                        </arc:SegmentedControl>
                    </arc:SettingsRow>
                </arc:SettingsGroup>

                <arc:SettingsGroup Header="关于" Appearance="Plain">
                    <arc:SettingsRow Header="版本" Description="本地 AI 翻译：文字和图片只发给本机的模型。">
                        <TextBlock Text="{Binding State.Version}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="检查更新" Description="{Binding UpdateHint}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <arc:Button Content="检查更新"
                                        Variant="Secondary"
                                        Command="{Binding CheckUpdateCommand}"
                                        AutomationProperties.Name="检查更新" />
                            <arc:Button Content="下载更新"
                                        Command="{Binding OpenUpdateCommand}"
                                        IsVisible="{Binding HasUpdate}"
                                        AutomationProperties.Name="下载更新" />
                        </StackPanel>
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="数据目录" Description="{Binding DataDirectory}">
                        <arc:Button Content="打开文件夹"
                                    Variant="Secondary"
                                    Command="{Binding OpenDataFolderCommand}"
                                    AutomationProperties.Name="打开数据目录" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="开源" Description="源码以 MIT 许可公开；推理用 Apache-2.0 的 Sdcb.HyMT2Sharp 与 Hy-MT3 权重。">
                        <TextBlock Text="MIT License"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </arc:SettingsRow>
                </arc:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
