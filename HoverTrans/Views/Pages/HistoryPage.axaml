<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:HoverTrans.ViewModels"
             x:Class="HoverTrans.Views.Pages.HistoryPage"
             x:DataType="vm:HistoryPageViewModel">
    <UserControl.Styles>
        <!-- Rows lift a hair under the pointer: enough to say "this is a thing you can act on". -->
        <Style Selector="Border.history-row">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.history-row:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>
        <Style Selector="Border.history-row Border.row-actions">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.history-row:pointerover Border.row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="24,18,24,20" RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding CountText}"
                       VerticalAlignment="Center"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

            <arc:Input Grid.Column="1"
                       Width="300"
                       HorizontalAlignment="Right"
                       Placeholder="搜索原文或译文"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       AutomationProperties.Name="搜索历史" />

            <arc:Button Grid.Column="2"
                        Content="{Binding ClearButtonText}"
                        Variant="Ghost"
                        Command="{Binding ClearAllCommand}"
                        IsVisible="{Binding !IsEmpty}"
                        AutomationProperties.Name="清空历史" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <arc:EmptyState IsVisible="{Binding IsEmpty}"
                                Icon="{lucide:LucideGeometry History}"
                                Title="还没有翻译记录"
                                Description="在翻译页翻过的文字会留在这里，点一下就能回到原文。"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="460"
                                Margin="0,72,0,0">
                    <arc:EmptyState.Action>
                        <arc:Button Content="去翻译" Command="{Binding GoTranslateCommand}" />
                    </arc:EmptyState.Action>
                </arc:EmptyState>

                <arc:EmptyState IsVisible="{Binding HasNoMatches}"
                                Icon="{lucide:LucideGeometry Search}"
                                Title="没有找到匹配的记录"
                                Description="换个关键词试试，搜索会同时看原文和译文。"
                                HorizontalAlignment="Center"
                                MaxWidth="460" />

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                            <Border Classes="history-row"
                                    Margin="0,0,0,8"
                                    Padding="16,14"
                                    Background="{arc:ArcDesignTokenResource Surface}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding SourcePreview}"
                                                   MaxLines="2"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                                   FontWeight="Medium"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                        <TextBlock Text="{Binding ResultPreview}"
                                                   MaxLines="2"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <arc:Badge Content="图片"
                                                       Size="Small"
                                                       Tone="Info"
                                                       IsVisible="{Binding IsFromImage}" />
                                            <TextBlock Text="{Binding LanguagePair}"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="·"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1" Classes="row-actions" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <arc:CopyButton Value="{Binding FullResult}"
                                                            IsIconOnly="True"
                                                            Variant="Plain"
                                                            Label="复制译文"
                                                            CopiedLabel="已复制"
                                                            FailedLabel="复制失败"
                                                            AutomationProperties.Name="复制译文" />
                                            <arc:Button Width="32"
                                                        Height="32"
                                                        MinHeight="0"
                                                        Padding="0"
                                                        CornerRadius="10"
                                                        Variant="Ghost"
                                                        Command="{Binding TranslateAgainCommand}"
                                                        AutomationProperties.Name="重新翻译"
                                                        arc:Tooltip.Tip="把原文放回翻译页并重新翻译">
                                                <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                                            </arc:Button>
                                            <arc:Button Width="32"
                                                        Height="32"
                                                        MinHeight="0"
                                                        Padding="0"
                                                        CornerRadius="10"
                                                        Variant="Ghost"
                                                        Command="{Binding RemoveCommand}"
                                                        AutomationProperties.Name="删除这条记录"
                                                        arc:Tooltip.Tip="删除这条记录">
                                                <lucide:LucideIcon Kind="Trash2" Size="14" />
                                            </arc:Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Margin="2,4,0,0"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
